---
/** Kort med ydelser eller gulvtyper: lille billede, navn, kort tekst og fra-pris. */
import cfg from '../calculator/pricing.config.js';
import { link } from '../lib/link.js';

interface Props {
  ydelser: any[];
}
const { ydelser } = Astro.props;
const billeder = import.meta.glob<{ default: ImageMetadata }>('../media/valg/*.webp', { eager: true });
const fmt = (n) => Math.round(n).toLocaleString('da-DK');
function fraPris(y) {
  if (y.overflade) return `fra ${fmt(cfg.overflader[y.overflade].prisPrM2 * (1 + cfg.moms))} kr/m²`;
  const r = cfg.rum[y.rum];
  if (!r) return '';
  const billigst = Math.min(...Object.values(cfg.overflader).map((o) => o.prisPrM2));
  return r.erhverv ? `fra ${fmt(billigst)} kr/m² ekskl. moms` : `fra ${fmt(billigst * (1 + cfg.moms))} kr/m²`;
}
---
<ul class="kort-grid">
  {ydelser.map((y) => (
    <li>
      <a class="kort" href={link(y.slug)}>
        <img class="kort-billede" src={billeder[`../media/valg/${y.kortBillede}.webp`]?.default.src} alt="" width="200" height="150" loading="lazy" decoding="async">
        <span class="kort-tekst">
          <span class="kort-navn">{y.navn} <span aria-hidden="true">→</span></span>
          <span class="kort-desk">{y.kort}</span>
          <span class="kort-pris">{fraPris(y)}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
