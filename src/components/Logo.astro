---
/**
 * Logoet: et rent ordmærke uden ikon. "Epoxy" spejler sig svagt i en blank gulvlinje under navnet,
 * ligesom lyset i et nyt epoxygulv. Spejlingen er pynt og læses ikke op.
 */
import { firma } from '../data/firma.js';
import { link } from '../lib/link.js';
---
<a class="logo" href={link()} aria-label={`${firma.navn}, til forsiden`}>
  <span class="logo-ord" aria-hidden="true">
    <span class="logo-1">Silkeborg</span><span class="logo-2">Epoxy<span class="logo-spejl">Epoxy</span></span>
  </span>
</a>
