---
/**
 * Farveprøver på gulvtypesiderne. `hex` giver en flad farve (ensfarvet), `billede` en prøve fra src/media/farver.
 * Prøverne er renderede eksempler, indtil kundens farvekort er lagt ind.
 */
import { Image } from 'astro:assets';

interface Props {
  titel: string;
  farver: { navn: string; kode?: string; hex?: string; billede?: string }[];
}
const { titel, farver } = Astro.props;
const billeder = import.meta.glob<{ default: ImageMetadata }>('../media/farver/*.webp', { eager: true });
const billede = (navn: string) => {
  const fil = billeder[`../media/farver/${navn}.webp`];
  if (!fil) throw new Error(`Farveprøve mangler: src/media/farver/${navn}.webp`);
  return fil.default;
};
---
<div class="farver">
  <h2>{titel}</h2>
  <ul class="farve-grid">
    {farver.map((f) => (
      <li>
        {f.billede
          ? <Image src={billede(f.billede)} alt="" widths={[240, 360]} sizes="(max-width: 560px) 45vw, 11rem" quality={60} class="farve-proeve" loading="lazy" decoding="async" />
          : <span class="farve-proeve farve-flad" style={`--farve: ${f.hex}`}></span>}
        <span class="farve-navn">{f.navn}</span>
        {f.kode && <span class="farve-kode">{f.kode}</span>}
      </li>
    ))}
  </ul>
  <p class="farve-note">Vi har farvekort og prøver med ved besigtigelsen, så du kan se farven i dit eget lys.</p>
  <p class="kladde-note">Farveprøverne er eksempler. Kundens egne farver skal ind her.</p>
</div>
