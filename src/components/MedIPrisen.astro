---
/**
 * "Det er med i prisen": hvad der altid er med, og hvad der kan komme oveni. Ingen beløb, kun indholdet.
 * Tilvalg og forbehandling hentes fra pricing.config.js, så listen passer med beregneren.
 */
import cfg from '../calculator/pricing.config.js';
import { link } from '../lib/link.js';

interface Props {
  alt?: boolean;
  harBeregner?: boolean;
}
const { harBeregner = true } = Astro.props;

const altidMed = [
  { ikon: 'besigtigelse', titel: 'Gratis besigtigelse', tekst: 'Vi kommer ud, måler op og måler fugten i betonen.' },
  { ikon: 'slibning', titel: 'Slibning af betonen', tekst: 'Så epoxyen hæfter og bliver en del af gulvet.' },
  { ikon: 'lag', titel: 'Primer, epoxy og toplak', tekst: 'Gulvet bygges op i lag, der passer til rummet.' },
  { ikon: 'oprydning', titel: 'Afdækning og oprydning', tekst: 'Vi dækker vægge og døre af og tager affaldet med.' },
  { ikon: 'bil', titel: 'Kørsel inden for 60 km', tekst: 'Fra Silkeborg. Kørslen er med i prisen.' },
];
const kanKommeOveni = [
  ...Object.values(cfg.stand).filter((s) => s.prisPrM2 > 0).map((s) => s.navn),
  ...Object.values(cfg.tilvalg).map((t) => t.navn),
  'Fugtspærre, hvis betonen er for fugtig',
];
---
<section class="med" aria-labelledby="med-titel">
  <div class="kolonne med-grid">
    <div class="med-intro moerk" data-vis>
      <p class="kick">Fast pris</p>
      <h2 class="sektion-titel" id="med-titel">Én fast pris. <em>Det hele er med.</em></h2>
      <p>Efter besigtigelsen får du prisen på skrift. Den ændrer sig ikke undervejs, heller ikke hvis arbejdet tager længere tid.</p>
      <a class="knap knap-hvid" href={harBeregner ? '#beregner' : link('pris')}>Se prisen på dit gulv <span aria-hidden="true">→</span></a>
      <div class="med-oveni">
        <p class="med-oveni-titel">Kan komme oveni, hvis gulvet kræver det</p>
        <ul>{kanKommeOveni.map((k) => <li>{k}</li>)}</ul>
        <p class="med-note">Du ser det i beregneren og i den faste pris, før du siger ja.</p>
      </div>
    </div>
    <div class="med-ark" data-vis aria-label="Eksempel på hvad prisen dækker">
      <div class="med-ark-top">
        <span class="med-ark-firma">Silkeborg <b>Epoxy</b></span>
        <span class="med-ark-meta">Prisoverslag<small>Eksempel</small></span>
      </div>
      <ul class="med-liste">
        {altidMed.map((m) => (
          <li>
            <span class="flueben" aria-hidden="true"></span>
            <span class="med-linje"><b>{m.titel}</b><span>{m.tekst}</span></span>
            <span class="med-tag">Med i prisen</span>
          </li>
        ))}
      </ul>
      <p class="med-sum"><span>Din faste pris<small>inkl. moms</small></span><strong aria-hidden="true">00.000 kr</strong></p>
      <p class="med-ark-fod">Prisen står på skrift efter den gratis besigtigelse.</p>
    </div>
  </div>
</section>
