---
/**
 * Ydelser som kort: et foto af rummet (eller gulvtypen), navn, kort tekst og fra-pris. Ingen ikoner.
 */
import { Image } from 'astro:assets';
import cfg from '../calculator/pricing.config.js';
import { link } from '../lib/link.js';
import Foto from './Foto.astro';
const rumFotos = import.meta.glob<{ default: ImageMetadata }>('../media/valg/rum-*.webp', { eager: true });

interface Props {
  ydelser: any[];
}
const { ydelser } = Astro.props;
const fmt = (n) => Math.round(n).toLocaleString('da-DK');
function fraPris(y) {
  if (y.overflade) return `fra ${fmt(cfg.overflader[y.overflade].prisPrM2 * (1 + cfg.moms))} kr/m²`;
  const r = cfg.rum[y.rum];
  if (!r) return '';
  const billigst = Math.min(...Object.values(cfg.overflader).map((o) => o.prisPrM2));
  return r.erhverv ? `fra ${fmt(billigst)} kr/m² ekskl. moms` : `fra ${fmt(billigst * (1 + cfg.moms))} kr/m²`;
}
---
<ul class="ydelses-liste">
  {ydelser.map((y) => (
    <li>
      <a href={link(y.slug)}>
        {y.overflade || !rumFotos[`../media/valg/rum-${y.rum}.webp`]
          ? <Foto navn={`gulv-${y.overflade ?? 'ensfarvet'}`} alt="" class="yl-foto" sizes="112px" />
          : <Image src={rumFotos[`../media/valg/rum-${y.rum}.webp`].default} alt="" widths={[200]} sizes="112px" quality={68} class="yl-foto" loading="lazy" decoding="async" />}
        <span class="yl-navn">{y.navn}</span>
        <span class="yl-desk">{y.kort}</span>
        <span class="yl-pris">{fraPris(y)} <span class="yl-pil" aria-hidden="true">→</span></span>
      </a>
    </li>
  ))}
</ul>
