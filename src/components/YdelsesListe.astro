---
/**
 * Ydelser som høje fotokort: et foto af rummet (eller gulvtypen), navn, kort tekst og fra-pris.
 * Fotoene ligger i src/media/foto og hedder rum-<rum>.jpg og overflade-<overflade>.jpg (pladsholdere).
 */
import cfg from '../calculator/pricing.config.js';
import { link } from '../lib/link.js';
import Foto from './Foto.astro';

interface Props {
  ydelser: any[];
}
const { ydelser } = Astro.props;
const fmt = (n) => Math.round(n).toLocaleString('da-DK');
function fraPris(y) {
  if (y.overflade) return `fra ${fmt(cfg.overflader[y.overflade].prisPrM2 * (1 + cfg.moms))} kr/m²`;
  const r = cfg.rum[y.rum];
  if (!r) return '';
  const billigst = Math.min(...Object.values(cfg.overflader).map((o) => o.prisPrM2));
  return r.erhverv ? `fra ${fmt(billigst)} kr/m² ekskl. moms` : `fra ${fmt(billigst * (1 + cfg.moms))} kr/m²`;
}
const foto = (y) => (y.overflade ? `overflade-${y.overflade}` : `rum-${y.rum}`);
---
<ul class="yk">
  {ydelser.map((y) => (
    <li data-vis>
      <a href={link(y.slug)}>
        <span class="yk-foto"><Foto navn={foto(y)} alt="" sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 25vw" /></span>
        <span class="yk-navn">{y.navn}</span>
        <span class="yk-desk">{y.kort}</span>
        <span class="yk-pris">{fraPris(y)} <span class="yk-pil" aria-hidden="true">→</span></span>
      </a>
    </li>
  ))}
</ul>
