---
/**
 * Forløbet: en blank stribe epoxy, der bliver trukket ud hen over siden, mens man scroller (som vejen med varevognen
 * på sikker-isolering.dk), og fire trin med små 3D-illustrationer under. Tiderne er pladsholdere i pricing.config.js.
 */
import { Image } from 'astro:assets';
import cfg from '../calculator/pricing.config.js';
import pris from '../media/ikon/trin-pris.png';
import fugt from '../media/ikon/trin-fugt.png';
import kalender from '../media/ikon/trin-kalender.png';
import gulv from '../media/ikon/trin-gulv.png';

interface Props { alt?: boolean; harBeregner?: boolean }
const { alt = false, harBeregner = true } = Astro.props;
const trin = [
  { billede: pris, naar: 'Nu', titel: 'Se din pris', tekst: 'Seks korte spørgsmål her på siden. Du binder dig ikke til noget.' },
  { billede: fugt, naar: 'Bagefter', titel: 'Gratis besigtigelse', tekst: 'Vi kommer ud, måler op og tjekker fugten i betonen. Så får du en fast pris på skrift.' },
  { billede: kalender, naar: 'Når det passer dig', titel: 'Vi finder en dag', tekst: 'Du vælger en dag. Gulvet tager typisk ' + cfg.tid.arbejdsdage.toLowerCase() + '.' },
  { billede: gulv, naar: 'Selve dagene', titel: 'Vi lægger gulvet', tekst: `${cfg.tid.gaaPaa}. ${cfg.tid.koerPaa}.` },
];
// Striben: en blød bølge over hele bredden med et punkt ved hvert trin
const punkter = [12.5, 37.5, 62.5, 87.5];
const y = (x) => 30 + Math.sin((x / 100) * Math.PI * 2 - 0.6) * 9;
const sti = Array.from({ length: 41 }, (_, i) => { const x = i * 2.5; return `${i ? 'L' : 'M'}${(x * 12).toFixed(1)} ${y(x).toFixed(1)}`; }).join(' ');
---
<section class:list={['sektion', 'fl', { 'sektion-alt': alt }]} aria-labelledby="forloeb-titel" data-forloeb>
  <div class="kolonne">
    <div class="fl-hoved" data-vis>
      <p class="kick">Sådan foregår det</p>
      <h2 class="sektion-titel" id="forloeb-titel">Fra pris til <em>færdigt gulv</em></h2>
      <p>Du siger ja, før vi går i gang. Ingen overraskelser undervejs.</p>
    </div>
    <div class="fl-stribe" aria-hidden="true">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
        <path class="fl-bund" d={sti} />
        <path class="fl-blank" d={sti} pathLength="1" />
      </svg>
      {punkter.map((x, i) => <span class="fl-prik" style={`left:${x}%;top:${y(x) / 60 * 100}%`}>{i + 1}</span>)}
    </div>
    <ol class="fl-trin">
      {trin.map((t) => (
        <li data-vis>
          <Image src={t.billede} alt="" width={260} height={260} class="fl-ikon" loading="lazy" />
          <span class="fl-naar">{t.naar}</span>
          <h3>{t.titel}</h3>
          <p><span data-pladsholder>{t.tekst}</span></p>
        </li>
      ))}
    </ol>
    <div class="fl-knap"><a class="knap knap-accent knap-stor" href={harBeregner ? '#beregner' : '/pris/'}>Se din pris <span aria-hidden="true">→</span></a></div>
  </div>
</section>
