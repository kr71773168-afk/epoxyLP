---
/**
 * Forsiden: de tre gulvtyper som store rækker med et foto, små mærker i billedet og en datastrimmel under teksten
 * (samme opbygning som ydelserne på sikker-isolering.dk). Fotoene er pladsholdere i src/media/foto/overflade-*.jpg.
 */
import cfg from '../calculator/pricing.config.js';
import { gulvtyper } from '../data/ydelser.js';
import { link } from '../lib/link.js';
import Foto from './Foto.astro';

const fmt = (n) => Math.round(n).toLocaleString('da-DK');
const ekstra = {
  ensfarvet: {
    titel: 'Det rene, klassiske gulv',
    maerker: [[22, 62, 'Blank overflade, ingen fuger'], [78, 30, 'Afspejler lyset', true]],
    egnet: 'Garage og kælder',
    udtryk: 'Rent og enkelt',
  },
  flakes: {
    titel: 'Flakes, der skjuler snavs',
    maerker: [[24, 78, 'Flakes giver greb'], [80, 48, 'Tåler bil og dæk', true]],
    egnet: 'Garage og værksted',
    udtryk: 'Granit-look',
  },
  metallic: {
    titel: 'Metallic, hvor intet gulv er ens',
    maerker: [[30, 82, 'Mønstret flyder selv'], [82, 70, 'Dybe spejlinger', true]],
    egnet: 'Bolig og butik',
    udtryk: 'Unikt mønster',
  },
};
---
<div class="gr">
  {gulvtyper.map((y, i) => {
    const e = ekstra[y.overflade];
    return (
      <article class:list={['gr-raekke', { vend: i % 2 === 1 }]} data-vis>
        <a class="gr-foto" href={link(y.slug)} tabindex="-1" aria-hidden="true">
          <Foto navn={`overflade-${y.overflade}`} alt="" sizes="(max-width: 900px) 100vw, 58vw" />
          {e.maerker.map(([x, top, t, v], k) => (
            <span class:list={['gr-maerke', { v }]} style={`left:${x}%;top:${top}%;--d:${.25 + k * .18}s`}><i></i><em>{t}</em></span>
          ))}
        </a>
        <div class="gr-tekst">
          <span class="gr-k">{String(i + 1).padStart(2, '0')} · {y.navn}</span>
          <h3>{e.titel}</h3>
          <p>{y.kort}</p>
          <dl class="gr-data">
            <div><dt>Pris fra</dt><dd><span data-pladsholder>{fmt(cfg.overflader[y.overflade].prisPrM2 * (1 + cfg.moms))} kr/m²</span></dd></div>
            <div><dt>Godt til</dt><dd>{e.egnet}</dd></div>
            <div><dt>Udtryk</dt><dd>{e.udtryk}</dd></div>
          </dl>
          <div class="gr-knapper">
            <a class="knap knap-accent" href="#beregner">Beregn pris <span aria-hidden="true">→</span></a>
            <a class="hero-book" href={link(y.slug)}>Læs om {y.navn.toLowerCase()}</a>
          </div>
        </div>
      </article>
    );
  })}
</div>
