---
/**
 * "Sådan bliver dit gulv til": samme garage i fem billeder (rå beton, slibning, primer, epoxy, flakes og toplak),
 * der toner over i hinanden, mens man scroller. Teksten til venstre skifter med, og små mærker peger på laget.
 * Billederne er 3D-illustrationer i samme clay-stil som sikker-isolering.dk og ligger i src/media/historie.
 * Ved "reducer bevægelse" står alle trin under hinanden med det færdige gulv.
 */
import { Image } from 'astro:assets';
import cfg from '../calculator/pricing.config.js';
import h0 from '../media/historie/h0.jpg';
import h1 from '../media/historie/h1.jpg';
import h2 from '../media/historie/h2.jpg';
import h3 from '../media/historie/h3.jpg';
import h4 from '../media/historie/h4.jpg';

interface Props { harBeregner?: boolean }
const { harBeregner = true } = Astro.props;

const billeder = [h0, h1, h2, h3, h4];
const trin = [
  { n: 'Før', titel: 'Betonen, som den er', tekst: 'De fleste garager har et råt betongulv. Det støver, suger olie og vand og er svært at holde rent.' },
  { n: '1 · Slibning', titel: 'Vi sliber betonen', tekst: 'Overfladen bliver slebet op, så epoxyen kan hæfte. Revner og huller bliver repareret.' },
  { n: '2 · Primer', titel: 'Primeren binder betonen', tekst: 'Primeren trænger ned i betonen og gør den klar til epoxyen.' },
  { n: '3 · Epoxy', titel: 'Epoxyen trækkes ud', tekst: 'Den flyder ud til en glat flade uden fuger og samlinger.' },
  { n: 'Færdig', titel: 'Flakes og toplak', tekst: `Flakes giver greb og skjuler snavs. Toplakken gør gulvet blankt og nemt at holde rent. ${cfg.tid.koerPaa}.` },
];
// Mærker i billedet: [trin, venstre %, top %, tekst, til venstre]
const maerker = [
  [0, 30, 88, 'Rå beton', false],
  [1, 52, 72, 'Slibemaskinen gør overfladen ru', false],
  [2, 47, 80, 'Primer', false],
  [3, 34, 84, 'Glat epoxy uden fuger', false],
  [4, 34, 86, 'Flakes og klar toplak', false],
];
---
<section class="hist" aria-labelledby="hist-titel" data-hist>
  <div class="hist-stik">
    <div class="hist-raekke">
      <div class="hist-tekst">
        <p class="kick">Sådan bliver dit gulv til</p>
        <h2 id="hist-titel">Fra rå beton til <em>blankt gulv</em></h2>
        <div class="hist-prog" aria-hidden="true">{[0, 1, 2, 3].map(() => <i></i>)}</div>
        <ol class="hist-trin">
          {trin.map((t, i) => (
            <li class:list={[{ 'er-aktiv': i === 0 }]}>
              <span class="hist-n">{t.n}</span>
              <b>{t.titel}</b>
              <p>{t.tekst}</p>
              {i === trin.length - 1 && <a class="knap knap-accent" href={harBeregner ? '#beregner' : '/pris/'}>Se prisen på dit gulv <span aria-hidden="true">→</span></a>}
            </li>
          ))}
        </ol>
      </div>
      <div class="hist-scene">
        {billeder.map((b, i) => (
          <Image src={b} alt={i === 0 ? 'Illustration af en garage, hvor gulvet bliver bygget op lag for lag: beton, slibning, primer, epoxy og til sidst flakes og toplak' : ''} widths={[800, 1280, 1800]} sizes="(max-width: 900px) 100vw, 64vw" quality={72} class="hist-billede" data-i={i} loading="lazy" decoding="async" />
        ))}
        {maerker.map(([t, x, y, tekst, v]) => (
          <span class:list={['hist-maerke', { v }]} data-t={t} style={`left:${x}%;top:${y}%`} aria-hidden="true"><i></i><em>{tekst}</em></span>
        ))}
      </div>
    </div>
  </div>
</section>
