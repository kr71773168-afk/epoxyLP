---
import { firma } from '../data/firma.js';
import { link } from '../lib/link.js';
import Foto from './Foto.astro';
import Ikon from './Ikon.astro';

interface Props {
  titel?: string;
  tekst?: string;
  harBeregner?: boolean;
  foto?: string;
}
const {
  titel = 'Se hvad dit gulv koster',
  tekst = 'Det tager et minut, og det er helt uforpligtende.',
  harBeregner = false,
  foto = 'hal',
} = Astro.props;
---
<section class="slut" aria-labelledby="slut-titel">
  <Foto navn={foto} alt="" class="slut-billede" sizes="100vw" />
  <div class="kolonne moerk">
    <h2 id="slut-titel">{titel}</h2>
    <p>{tekst}</p>
    <div class="slut-knapper">
      <a class="knap knap-stor knap-accent" href={harBeregner ? '#beregner' : link('pris')}>Beregn din pris <span aria-hidden="true">→</span></a>
      <a class="knap knap-stor knap-hvid" href={`tel:${firma.telefonLink}`} data-telefon><Ikon navn="tlf" />Ring <span data-pladsholder>{firma.telefon}</span></a>
    </div>
  </div>
</section>
