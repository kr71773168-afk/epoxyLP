---
import { firma } from '../data/firma.js';
import { link } from '../lib/link.js';
import Foto from './Foto.astro';
import Ikon from './Ikon.astro';

interface Props {
  titel?: string;
  tekst?: string;
  harBeregner?: boolean;
  foto?: string;
}
const {
  titel = 'Klar til [et nyt gulv]?',
  tekst = 'Se prisen på dit gulv på et minut. Det er gratis og uforpligtende.',
  harBeregner = false,
  foto = 'hal',
} = Astro.props;
const titelHtml = titel.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]).replace(/\[(.+?)\]/g, '<em>$1</em>');
---
<section class="slut" aria-labelledby="slut-titel">
  <Foto navn={foto} alt="" class="slut-billede" sizes="100vw" />
  <div class="kolonne moerk">
    <h2 id="slut-titel" set:html={titelHtml} />
    <p>{tekst}</p>
    <div class="slut-knapper">
      <a class="knap knap-stor knap-accent" href={harBeregner ? '#beregner' : link('pris')}>Beregn din pris <span aria-hidden="true">→</span></a>
      <a class="knap knap-stor knap-hvid" href={`tel:${firma.telefonLink}`} data-telefon><Ikon navn="tlf" />Ring <span data-pladsholder>{firma.telefon}</span></a>
    </div>
    <ul class="slut-tillid">
      <li>Fast pris efter gratis besigtigelse</li>
      <li>Silkeborg og 60 km omkring</li>
      <li><span data-pladsholder>{firma.garanti}</span></li>
    </ul>
  </div>
</section>
