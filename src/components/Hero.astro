---
/**
 * Toppen på forsiden, prissiden, ydelserne og bysiderne: overskrift, flueben, knapper og beregneren.
 * medie="video" viser videoen fra et job som levende baggrund. Ellers et foto fra src/media/foto (navnet uden .jpg).
 * Stil A og C: mediet fylder hele toppen bag en mørk tone. Stil B: mediet står i en rund ramme, og beregneren ligger ind over.
 * Skriv [ord] i titlen for at fremhæve dem, fx "Epoxygulve i Silkeborg. [Se prisen på 60 sekunder.]"
 * `punkter` er korte løfter med flueben. De må indeholde HTML (fx en pladsholder).
 * Slot "top" er til brødkrummer. Standard-slot kommer under teksten (fx fakta om byen).
 * På mobil står beregneren lige under overskriften (over folden). Flueben og knapper kommer efter beregneren.
 */
import { Image } from 'astro:assets';
import { firma } from '../data/firma.js';
import { link } from '../lib/link.js';
import plakat from '../media/arbejde.jpg';
import mp4 from '../media/arbejde.mp4?url';
import webm from '../media/arbejde.webm?url';
import Beregner from './Beregner.astro';
import Foto from './Foto.astro';
import Ikon from './Ikon.astro';

interface Props {
  titel: string;
  over?: string;
  tekst?: string;
  punkter?: string[];
  medie?: string;
  rum?: string;
  overflade?: string;
  bjaelke?: boolean;
  annonceTitel?: boolean;
}
const { titel, over, tekst, punkter = [], medie = 'video', rum, overflade, bjaelke = false, annonceTitel = false } = Astro.props;

const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
const titelHtml = esc(titel).replace(/\[(.+?)\]/g, '<em>$1</em>');
const a = firma.anmeldelser;
const harAnmeldelser = Boolean(a.snit && a.antal);
const garanti = firma.garanti.replace(/ garanti$/, '');
---
<section class:list={['hero', { 'hero-med-bjaelke': bjaelke }]} aria-labelledby="hero-titel">
  <div class="hero-medie">
    {medie === 'video' ? (
      <>
      <Image src={plakat} alt="" widths={[640, 960, 1280]} sizes="100vw" quality={62} loading="eager" fetchpriority="high" decoding="async" class="hero-plakat" />
      <video class="hero-video" muted loop playsinline disablepictureinpicture preload="none" data-auto aria-hidden="true" tabindex="-1">
        <source src={webm} type="video/webm">
        <source src={mp4} type="video/mp4">
      </video>
      </>
    ) : (
      <Foto navn={medie} alt="" class="hero-plakat" sizes="100vw" eager />
    )}
  </div>
  {medie === 'video' && (
    <p class="hero-video-tekst">
      <span class="hero-video-prik" aria-hidden="true"></span>Fra et af vores jobs
      <button type="button" class="hero-video-knap" data-video-knap aria-label="Stop videoen" hidden>
        <Ikon navn="pause" class="ikon-pause" /><Ikon navn="afspil" class="ikon-afspil" />
      </button>
    </p>
  )}

  <div class="hero-tekst">
    <slot name="top" />
    {(harAnmeldelser || firma.kladde) && (
      <p class="hero-rating" data-kun-kladde={harAnmeldelser ? undefined : ''}>
        <span class="stjerner" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Ikon navn="stjerne" />)}</span>
        {harAnmeldelser ? <span>{a.snit} ud af 5 · {a.antal} anmeldelser på {a.kilde}</span> : <span>Anmeldelser på {a.kilde} <span class="hero-rating-pl" data-pladsholder>pladsholder</span></span>}
      </p>
    )}
    {over && <p class="hero-over">{over}</p>}
    <h1 id="hero-titel" data-hero-titel={annonceTitel ? '' : undefined} set:html={titelHtml} />
    {tekst && <p class="hero-sub">{tekst}</p>}
    <slot />
  </div>

  <div class="hero-ekstra">
    {punkter.length > 0 && (
      <ul class="tjekliste hero-punkter">
        {punkter.map((p) => <li><Ikon navn="tjek" /><span set:html={p} /></li>)}
      </ul>
    )}
    <div class="hero-knapper">
      <a class="knap knap-accent hero-tlf" href={`tel:${firma.telefonLink}`} data-telefon><Ikon navn="tlf" />Ring <span data-pladsholder>{firma.telefon}</span></a>
      <a class="knap knap-hvid hero-book" href={link('kontakt')}>Book gratis besigtigelse</a>
    </div>
  </div>

  <div class="hero-beregner">
    <Beregner rum={rum} overflade={overflade} />
  </div>

  {bjaelke && (
    <ul class="hero-bjaelke">
      <li><Ikon navn="ur" /><b>60 sek.</b><span>til en pris</span></li>
      <li><Ikon navn="kontrakt" /><b>Fast pris</b><span>på skrift</span></li>
      <li><Ikon navn="skjold" /><b><span data-pladsholder>{garanti}</span></b><span>garanti</span></li>
      <li><Ikon navn="sted" /><b>60 km</b><span>kørsel med i prisen</span></li>
    </ul>
  )}
</section>
