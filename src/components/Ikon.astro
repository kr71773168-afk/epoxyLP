---
/**
 * Små ikoner som inline SVG. Farven følger teksten (currentColor), fluebenet følger stilen (se .tjek i base.css).
 * Streg-ikonerne (garage, skjold, ur …) kommer fra Lucide og står i src/lib/ikoner.js.
 */
import { streg } from '../lib/ikoner.js';

interface Props {
  navn: string;
  class?: string;
}
const { navn, class: klasse } = Astro.props;
---
{streg[navn] && (
  <svg class:list={['streg-ikon', klasse]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={streg[navn]} />
)}
{navn === 'tlf' && (
  <svg class:list={['knap-ikon', klasse]} viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5l2.6 3.3-1.6 2.3a13 13 0 0 0 7.3 7.3l2.3-1.6 3.3 2.6-1.2 3.1a2 2 0 0 1-2.2 1.2C10.5 20.3 3.7 13.5 2.3 6.9a2 2 0 0 1 1.2-2.2z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" /></svg>
)}
{navn === 'stjerne' && (
  <svg class={klasse} viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3.1-5.4 3.1 1.2-6L1.3 7.8l6.1-.7z" /></svg>
)}
{navn === 'tjek' && (
  <svg class:list={['tjek', klasse]} viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" /><path d="M5.6 10.4l3 3 5.9-6.4" /></svg>
)}
{navn === 'pause' && (
  <svg class={klasse} viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.2v10H4.5zM9.3 3h2.2v10H9.3z" fill="currentColor" /></svg>
)}
{navn === 'afspil' && (
  <svg class={klasse} viewBox="0 0 16 16" aria-hidden="true"><path d="M5 2.8v10.4L13.2 8z" fill="currentColor" /></svg>
)}
{navn === 'laas' && (
  <svg class={klasse} viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 7V5.2a3.5 3.5 0 0 1 7 0V7M3.5 7h9v6.5h-9z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
)}
