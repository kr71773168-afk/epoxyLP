---
import '@fontsource-variable/lexend';
import lexend from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import '@fontsource-variable/manrope';
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '@fontsource-variable/red-hat-display';
import redHatDisplay from '@fontsource-variable/red-hat-display/files/red-hat-display-latin-wght-normal.woff2?url';
import '@fontsource-variable/red-hat-text';
import redHatText from '@fontsource-variable/red-hat-text/files/red-hat-text-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/side.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { byer } from '../data/byer.js';
import { firma } from '../data/firma.js';
import { fil, link } from '../lib/link.js';

interface Props {
  titel: string;
  beskrivelse: string;
  slug?: string;
  schema?: object[];
}
const { titel, beskrivelse, slug = '', schema = [] } = Astro.props;
// Skriften til sidens stilart hentes med det samme. I kladden vælger scriptet i <head> skriften til den valgte stil.
const alleSkrifter = { A: [redHatDisplay, redHatText], B: [lexend], C: [manrope] };
const skrifter = alleSkrifter[firma.stil] ?? alleSkrifter.C;
const kanonisk = new URL(slug ? `/${slug}/` : '/', Astro.site).href;

// Firmaet som lokal virksomhed, så Google kan vise navn, telefon og område
const virksomhed = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: firma.navn,
  legalName: firma.juridiskNavn,
  url: new URL('/', Astro.site).href,
  telephone: firma.telefonLink,
  email: firma.mail,
  vatID: `DK${firma.cvr}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: firma.adresse.vej,
    postalCode: firma.adresse.postnr,
    addressLocality: firma.adresse.by,
    addressCountry: 'DK',
  },
  image: new URL('/og.jpg', Astro.site).href,
  areaServed: byer.map((b) => ({ '@type': 'City', name: b.navn })),
  priceRange: 'kr',
};
---
<!doctype html>
<html lang="da" data-stil={firma.stil} class:list={[{ kladde: firma.kladde }]}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{titel}</title>
    {firma.kladde && (
      <script is:inline define:vars={{ standard: firma.stil, skrifter: alleSkrifter }}>
        // Kladde: stilen (A, B, C) kan vælges med knapperne i toppen eller ?stil=B i adressen. Sættes før siden tegnes.
        var s = '';
        try { s = new URLSearchParams(location.search).get('stil') || ''; } catch (e) {}
        try { if (s) localStorage.setItem('se-stil', s.toUpperCase()); else s = localStorage.getItem('se-stil') || ''; } catch (e) {}
        s = s.toUpperCase();
        if (!/^[ABC]$/.test(s)) s = standard;
        document.documentElement.setAttribute('data-stil', s);
        // Pladsholderne markeres kun, når man har slået det til i bjælken
        try { if (localStorage.getItem('se-pladsholdere') === '1') document.documentElement.classList.add('vis-pladsholdere'); } catch (e) {}
        // Hent stilens skrift med det samme, så teksten ikke hopper, når den kommer
        (skrifter[s] || []).forEach(function (f) {
          var l = document.createElement('link');
          l.rel = 'preload'; l.as = 'font'; l.type = 'font/woff2'; l.crossOrigin = 'anonymous'; l.href = f;
          document.head.appendChild(l);
        });
      </script>
    )}
    {!firma.kladde && skrifter.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin>)}
    <meta name="description" content={beskrivelse}>
    {firma.kladde && <meta name="robots" content="noindex, nofollow">}
    <link rel="canonical" href={kanonisk}>
    <meta name="theme-color" content="#FFFFFF">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="da_DK">
    <meta property="og:site_name" content={firma.navn}>
    <meta property="og:title" content={titel}>
    <meta property="og:description" content={beskrivelse}>
    <meta property="og:url" content={kanonisk}>
    <meta property="og:image" content={new URL('/og.jpg', Astro.site).href}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Silkeborg Epoxy: Se prisen på dit epoxygulv">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href={fil('favicon.svg')} type="image/svg+xml">
    <link rel="icon" href={fil('favicon-32.png')} sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href={fil('apple-touch-icon.png')}>
    <script type="application/ld+json" set:html={JSON.stringify(virksomhed)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="spring" href="#indhold">Spring til indholdet</a>
    <Header aktiv={slug} />
    <main id="indhold">
      <slot />
    </main>
    <Footer />

    <div class="samtykke" id="samtykke" role="region" aria-labelledby="samtykke-titel" hidden>
      <p class="samtykke-titel" id="samtykke-titel">Cookies</p>
      <p>Vi vil gerne bruge cookies til at måle, om vores annoncer på Facebook og Instagram virker. Siden virker fint uden.</p>
      <div class="samtykke-knapper">
        <button type="button" class="knap knap-lys" data-samtykke="nej">Nej tak</button>
        <button type="button" class="knap knap-lys" data-samtykke="ja">Ja tak</button>
      </div>
      <a class="samtykke-link" href={link('privatliv', '#cookies')}>Læs mere</a>
    </div>

    {firma.kladde && (
      <div class="kladde-panel">
        <button type="button" class="kladde-fane" aria-expanded="false" aria-controls="kladde-indhold"><span class="kladde-prik" aria-hidden="true"></span>Kladde</button>
        <div class="kladde-indhold" id="kladde-indhold" hidden>
          <p class="kladde-tekst">Priser, tekster og billeder er ikke endelige.</p>
          <p class="kladde-titel">Stilart</p>
          <div class="stilvaelger" role="group" aria-label="Vælg stilart">
            <button type="button" data-stil-knap="A" aria-pressed="false">A · Blå</button>
            <button type="button" data-stil-knap="B" aria-pressed="false">B · Grøn</button>
            <button type="button" data-stil-knap="C" aria-pressed="false">C · Egen</button>
          </div>
          <button type="button" class="kladde-knap" data-pladsholder-knap aria-pressed="false">Vis pladsholdere</button>
        </div>
      </div>
    )}

    <script>
      import '../scripts/side.js';
    </script>
  </body>
</html>
