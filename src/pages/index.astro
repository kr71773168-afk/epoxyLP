---
import Beregner from '../components/Beregner.astro';
import FAQ from '../components/FAQ.astro';
import Forloeb from '../components/Forloeb.astro';
import Slut from '../components/Slut.astro';
import Tillid from '../components/Tillid.astro';
import Video from '../components/Video.astro';
import YdelsesListe from '../components/YdelsesListe.astro';
import { faq } from '../data/faq.js';
import { firma } from '../data/firma.js';
import { erhverv, gulvtyper, privat } from '../data/ydelser.js';
import Side from '../layouts/Side.astro';

// Det, der adskiller firmaet fra de fleste gulvfirmaer. Garantien er en pladsholder i firma.js.
const loefter = [
  { titel: 'Prisen står på siden', tekst: 'De fleste gulvfirmaer skriver “ring for pris”. Her ser du en vejledende pris på et minut, før du taler med nogen.' },
  { titel: 'Ejeren kommer selv', tekst: 'Du taler med den, der lægger gulvet. Fra første besøg til sidste lag.' },
  { titel: 'Fast pris på skrift', tekst: 'Efter den gratis besigtigelse får du en fast pris. Den ændrer sig ikke undervejs.' },
  { titel: firma.garanti, tekst: 'Vi står inde for gulvet. Sker der noget, der skyldes vores arbejde, kommer vi og udbedrer det.', pladsholder: true },
];
---
<Side
  titel="Epoxygulve i Silkeborg · Se prisen på 60 sekunder · Silkeborg Epoxy"
  beskrivelse="Epoxygulve til garage, kælder, bolig og erhverv i Silkeborg og 60 km omkring. Se prisen på dit gulv på et minut. Fast pris efter gratis besigtigelse."
>
  <section class="kolonne hero" aria-labelledby="hero-titel">
    <div class="hero-tekst">
      <p class="hero-over">Epoxygulve i Silkeborg og 60 km omkring</p>
      <h1 id="hero-titel" data-hero-titel>Epoxygulve til garage, kælder, bolig og erhverv</h1>
      <p class="hero-sub">Se prisen på dit nye gulv på et minut. Du skal ikke give os dit nummer for at se den.</p>
    </div>
    <Beregner />
    <Tillid />
    <Video class="hero-video" />
  </section>

  <section class="sektion" aria-labelledby="loefter-titel">
    <div class="kolonne">
      <h2 class="sektion-titel" id="loefter-titel">Derfor vælger folk os</h2>
      <ul class="fordele">
        {loefter.map((l) => (
          <li>
            <h3>{l.pladsholder ? <span data-pladsholder>{l.titel}</span> : l.titel}</h3>
            <p>{l.tekst}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Forloeb />

  <section class="sektion" aria-labelledby="ydelser-titel">
    <div class="kolonne">
      <div class="sektion-hoved">
        <h2 class="sektion-titel" id="ydelser-titel">Det laver vi</h2>
        <p>Garager, kældre, boliger og erhverv, i ensfarvet, flakes eller metallic.</p>
      </div>
      <YdelsesListe ydelser={[...privat, ...erhverv, ...gulvtyper]} />
    </div>
  </section>

  <FAQ items={faq} />
  <Slut harBeregner />
</Side>
