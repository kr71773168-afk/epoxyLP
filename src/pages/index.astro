---
import FAQ from '../components/FAQ.astro';
import Forloeb from '../components/Forloeb.astro';
import Foto from '../components/Foto.astro';
import GulvKort from '../components/GulvKort.astro';
import Hero from '../components/Hero.astro';
import Ikon from '../components/Ikon.astro';
import MedIPrisen from '../components/MedIPrisen.astro';
import Slut from '../components/Slut.astro';
import YdelsesListe from '../components/YdelsesListe.astro';
import { faq } from '../data/faq.js';
import { firma } from '../data/firma.js';
import { erhverv, privat } from '../data/ydelser.js';
import Side from '../layouts/Side.astro';
import { link } from '../lib/link.js';

// Det, der adskiller firmaet fra de fleste gulvfirmaer. Garantien er en pladsholder i firma.js.
const loefter = [
  { titel: 'Pris på et minut', tekst: 'De fleste gulvfirmaer skriver “ring for pris”. Her får du en vejledende pris på et minut, uden at vente på et tilbud.' },
  { titel: 'Ejeren kommer selv', tekst: 'Du taler med den, der lægger gulvet. Fra første besøg til sidste lag.' },
  { titel: 'Fast pris på skrift', tekst: 'Efter den gratis besigtigelse får du en fast pris. Den ændrer sig ikke undervejs.' },
  { titel: firma.garanti, tekst: 'Vi står inde for gulvet. Sker der noget, der skyldes vores arbejde, kommer vi og udbedrer det.', pladsholder: true },
];
const garantiAar = firma.garanti.replace(/ års? garanti$/, '');
const ejerNavn = firma.ejer.startsWith('[') ? 'Ejeren' : firma.ejer;
---
<Side
  titel="Epoxygulve i Silkeborg · Se prisen på 60 sekunder · Silkeborg Epoxy"
  beskrivelse="Epoxygulve til garage, kælder, bolig og erhverv i Silkeborg og 60 km omkring. Se prisen på dit gulv på et minut. Fast pris efter gratis besigtigelse."
>
  <Hero
    over="Garage · kælder · bolig · erhverv"
    titel="Epoxygulve i Silkeborg. [Se prisen på 60 sekunder.]"
    punkter={[
      'Pris på et minut, gratis og uforpligtende',
      'Fast pris på skrift efter gratis besigtigelse',
      `<span data-pladsholder>${firma.garanti}</span>, og ejeren kommer selv`,
    ]}
    bjaelke
    annonceTitel
  />

  <section class="sektion" aria-labelledby="gulve-titel">
    <div class="kolonne">
      <div class="sektion-hoved">
        <div>
          <h2 class="sektion-titel" id="gulve-titel">Vælg dit <em>epoxygulv</em></h2>
          <p>Tre overflader. Prisen pr. m² står på hver, inkl. moms.</p>
        </div>
        <a class="knap knap-lys" href={link('pris')}>Se alle priser <span aria-hidden="true">→</span></a>
      </div>
      <GulvKort />
    </div>
  </section>

  <section class="sektion sektion-alt" aria-labelledby="loefter-titel">
    <div class="kolonne folk">
      <div class="folk-billede-ramme">
        <Foto navn="arbejde-taet" alt="Vi trækker epoxy ud over et gulv på et job" class="folk-billede" sizes="(max-width: 900px) 100vw, 50vw" />
        <p class="segl"><Ikon navn="skjold" /><b><span data-pladsholder>{garantiAar}</span> år</b><span>garanti</span></p>
        <figure class="citat">
          <blockquote><p><span data-pladsholder>“Jeg kommer selv ud og måler op, og jeg er der, når gulvet bliver lagt. Så ved du, hvem du har med at gøre.”</span></p></blockquote>
          <figcaption><span data-pladsholder>{ejerNavn}</span>, Silkeborg Epoxy</figcaption>
        </figure>
      </div>
      <div>
        <h2 class="sektion-titel" id="loefter-titel">Derfor vælger folk os</h2>
        <ul class="folk-liste">
          {loefter.map((l) => (
            <li>
              <Ikon navn="tjek" />
              <h3>{l.pladsholder ? <span data-pladsholder>{l.titel}</span> : l.titel}</h3>
              <p>{l.tekst}</p>
            </li>
          ))}
        </ul>
        <a class="knap knap-lys" href={link('om-os')}>Mere om os <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Forloeb />
  <MedIPrisen alt />

  <section class="sektion" aria-labelledby="ydelser-titel">
    <div class="kolonne">
      <div class="sektion-hoved">
        <div>
          <h2 class="sektion-titel" id="ydelser-titel">Gulve til hjem og erhverv</h2>
          <p>Garager, kældre, boliger og erhverv. Vælg dit rum og se, hvad vi kan.</p>
        </div>
      </div>
      <YdelsesListe ydelser={[...privat, ...erhverv]} />
    </div>
  </section>

  <FAQ items={faq} alt />
  <Slut harBeregner />
</Side>
