---
import FAQ from '../components/FAQ.astro';
import Forloeb from '../components/Forloeb.astro';
import Foto from '../components/Foto.astro';
import GulvRaekker from '../components/GulvRaekker.astro';
import Hero from '../components/Hero.astro';
import MedIPrisen from '../components/MedIPrisen.astro';
import Omraade from '../components/Omraade.astro';
import Slut from '../components/Slut.astro';
import YdelsesListe from '../components/YdelsesListe.astro';
import { faq } from '../data/faq.js';
import { firma } from '../data/firma.js';
import { erhverv, privat } from '../data/ydelser.js';
import Side from '../layouts/Side.astro';
import { link } from '../lib/link.js';
import { Image } from 'astro:assets';
import plakat from '../media/arbejde.jpg';
import mp4 from '../media/arbejde.mp4?url';
import webm from '../media/arbejde.webm?url';

---
<Side
  titel="Epoxygulve i Silkeborg · Se prisen på 60 sekunder · Silkeborg Epoxy"
  beskrivelse="Epoxygulve til garage, kælder, bolig og erhverv i Silkeborg og 60 km omkring. Se prisen på dit gulv på et minut. Fast pris efter gratis besigtigelse."
>
  <Hero
    over="Garage · kælder · bolig · erhverv"
    titel="Epoxygulve i Silkeborg. [Se prisen på 60 sekunder.]"
    tekst="Svar på seks korte spørgsmål, så ser du prisen med det samme. Fast pris på skrift efter en gratis besigtigelse."
    bjaelke
    annonceTitel
  />

  <section class="sektion" aria-labelledby="gulve-titel">
    <div class="kolonne">
      <GulvRaekker />
    </div>
  </section>

  <section class="sektion os" aria-labelledby="loefter-titel">
    <div class="kolonne os-grid">
      <div class="os-medie" data-vis>
        <div class="os-video">
          <Image src={plakat} alt="" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" quality={68} class="os-plakat" loading="lazy" decoding="async" />
          <video muted loop playsinline disablepictureinpicture preload="none" data-auto aria-label="Video fra et af vores jobs: epoxyen bliver trukket ud over gulvet">
            <source src={webm} type="video/webm">
            <source src={mp4} type="video/mp4">
          </video>
        </div>
        <div class="os-kort">
          <p class="os-kort-titel">Samme mand hele vejen</p>
          <ul>
            <li><span class="flueben" aria-hidden="true"></span>Måler op og tjekker fugten</li>
            <li><span class="flueben" aria-hidden="true"></span>Giver dig prisen på skrift</li>
            <li><span class="flueben" aria-hidden="true"></span>Lægger gulvet selv</li>
          </ul>
        </div>
      </div>
      <div class="os-tekst" data-vis>
        <p class="kick">Om os</p>
        <h2 class="sektion-titel" id="loefter-titel">Du taler med den, <em>der lægger gulvet</em></h2>
        <p class="os-lede">Silkeborg Epoxy er et lille, lokalt firma. Ejeren kommer selv ud, måler op og står for gulvet fra første besøg til sidste lag.</p>
        <p class="os-mere">Du får prisen på et minut her på siden. Efter besigtigelsen står den på skrift, og den ændrer sig ikke.</p>
        <dl class="fakta-kort">
          <div><span class="flueben" aria-hidden="true"></span><dt>Ejeren</dt><dd>Kommer selv</dd></div>
          <div><span class="flueben" aria-hidden="true"></span><dt>Prisen</dt><dd>Fast på skrift</dd></div>
          <div><span class="flueben" aria-hidden="true"></span><dt>Garanti</dt><dd><span data-pladsholder>{firma.garanti}</span></dd></div>
        </dl>
        <div class="gr-knapper">
          <a class="knap knap-accent" href="#beregner">Beregn din pris <span aria-hidden="true">→</span></a>
          <a class="hero-tlf os-tlf" href={`tel:${firma.telefonLink}`} data-telefon><span class="hero-tlf-ring" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></span><span data-pladsholder>{firma.telefon}</span></a>
        </div>
      </div>
    </div>
  </section>

  <Forloeb />
  <MedIPrisen alt />

  <section class="sektion sektion-alt" aria-labelledby="ydelser-titel">
    <div class="kolonne">
      <div class="sektion-hoved">
        <div>
          <p class="kick">Ydelser</p>
          <h2 class="sektion-titel" id="ydelser-titel">Gulve til hjem og erhverv</h2>
          <p>Garager, kældre, boliger og erhverv. Vælg dit rum og se, hvad vi kan.</p>
        </div>
      </div>
      <YdelsesListe ydelser={[...privat, ...erhverv]} />
    </div>
  </section>

  <Omraade />
  <FAQ items={faq} alt />
  <Slut harBeregner foto="overflade-flakes" />
</Side>
