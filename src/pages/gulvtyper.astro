---
/**
 * Gulvkataloget som en interaktiv brochure: en side for sig selv uden menuen.
 * Et kort pr. gulvtype med foto, overflade, farver, fordele og en grøn bjælke. Et tryk på en farve skifter overfladen,
 * og et tryk på overfladen viser den i stort. Data i src/data/katalog.js, farver og udseende i src/styles/brochure.css.
 */
import { Image } from 'astro:assets';
import Ikon from '../components/Ikon.astro';
import { firma } from '../data/firma.js';
import { katalog } from '../data/katalog.js';
import Side from '../layouts/Side.astro';
import { link } from '../lib/link.js';
import hero from '../media/brochure/hero.jpg';
import '../styles/brochure.css';

const store = import.meta.glob<{ default: ImageMetadata }>('../media/katalog/*.jpg', { eager: true });
const flader = import.meta.glob<{ default: ImageMetadata }>('../media/katalog/flade/*.jpg', { eager: true });
const proever = import.meta.glob<{ default: ImageMetadata }>('../media/katalog/proeve/*.jpg', { eager: true });
const scener = import.meta.glob<{ default: ImageMetadata }>('../media/brochure/scene-*.jpg', { eager: true });
const hent = (samling, sti) => {
  const fil = samling[sti];
  if (!fil) throw new Error(`Billede mangler: ${sti}`);
  return fil.default;
};
const typer = katalog.map((g) => ({
  ...g,
  scene: hent(scener, `../media/brochure/scene-${g.slug}.jpg`),
  farver: g.farver.map((f) => ({
    ...f,
    billede: hent(store, `../media/katalog/${g.slug}-${f.slug}.jpg`),
    flade: hent(flader, `../media/katalog/flade/${g.slug}-${f.slug}.jpg`),
    proeve: hent(proever, `../media/katalog/proeve/${g.slug}-${f.slug}.jpg`),
  })),
}));

const loefter = [
  { ikon: 'skjold', titel: firma.garanti, tekst: 'på gulvet, skrevet ind i aftalen', pladsholder: true },
  { ikon: 'kontrakt', titel: 'Fast pris', tekst: 'på skrift, før vi går i gang' },
  { ikon: 'besigtigelse', titel: 'Gratis besigtigelse', tekst: 'og ærlig rådgivning om gulvtypen' },
  { ikon: 'sted', titel: 'Lokalt firma', tekst: 'i Silkeborg og 60 km omkring' },
];
// Radiogruppen med farver bruges både på kortet og i den store visning
const farvetekst = (f) => (f.kode ? ` · ${f.kode}` : '');
---
<Side
  titel="Vores gulvtyper · Farver og overflader · Silkeborg Epoxy"
  beskrivelse="Industrigulv, Flake Floor, Color Quartz, PU-gulv og stentæppe. Se overfladerne, tryk på en farve, og find det gulv, der passer til dig."
  slug="gulvtyper"
  selvstaendig
>
  <section class="bro-hero" aria-labelledby="bro-titel">
    <Image src={hero} alt="" class="bro-hero-billede" widths={[640, 943]} sizes="(max-width: 760px) 100vw, 65vw" quality={78} loading="eager" fetchpriority="high" />
    <div class="bro-kolonne bro-hero-indre">
      <p class="bro-tag">Stærke gulve<br>til krævende miljøer</p>
      <h1 id="bro-titel">Vores<br>gulvtyper</h1>
      <p class="bro-hero-tekst">Vi tilbyder en række slidstærke og flotte gulvløsninger, der kombinerer funktion, holdbarhed og et godt udtryk. Her er vores fem gulvtyper. Tryk på en farve, og se overfladen.</p>
      <nav class="bro-hop" aria-label="Gulvtyperne">
        {typer.map((g) => <a href={`#${g.slug}`}>{g.navn}</a>)}
      </nav>
    </div>
  </section>

  <div class="bro-kolonne bro-kort-ramme">
    <ul class="bro-kort-liste">
      {typer.map((g, gi) => (
        <li>
          <article class="bro-kort" id={g.slug} aria-labelledby={`${g.slug}-titel`} data-katalog>
            <div class="bro-foto">
              <Image src={g.scene} alt="" widths={[334]} sizes="334px" quality={82} loading={gi < 2 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            <button type="button" class="bro-flade" data-forstoer={g.slug}>
              {g.farver.map((f, fi) => (
                <Image src={f.flade} alt="" widths={[320, 640]} sizes="(max-width: 560px) 92vw, 320px" quality={80} loading="lazy" decoding="async" data-farve={f.slug} hidden={fi !== 0} />
              ))}
              <span class="bro-flade-tekst"><Ikon navn="forstoer" />Se i stort<span class="vh"> {g.navn}</span></span>
            </button>

            <div class="bro-krop">
              <h2 id={`${g.slug}-titel`}>{g.navn}</h2>
              <div class="bro-farver">
                <div class="bro-proever" role="radiogroup" aria-label={`Farver til ${g.navn}`}>
                  {g.farver.map((f, fi) => (
                    <button type="button" role="radio" class="bro-proeve" aria-checked={fi === 0 ? 'true' : 'false'} tabindex={fi === 0 ? 0 : -1}
                      data-type={g.slug} data-farve={f.slug} data-navn={f.navn} data-kode={f.kode ?? ''} aria-label={f.kode ? `${f.navn}, ${f.kode}` : f.navn}>
                      <Image src={f.proeve} alt="" width={72} height={72} quality={80} loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
                <p class="bro-farvenavn" aria-live="polite">Farve: <b data-navn-for={g.slug}>{g.farver[0].navn}</b><span data-kode-for={g.slug}>{farvetekst(g.farver[0])}</span></p>
              </div>
              <p class="bro-tekst">{g.tekst}</p>
              <ul class="bro-fordele">
                {g.fordele.map((f) => (
                  <li><span class="bro-ikon"><Ikon navn={f.ikon} /></span>{f.tekst}</li>
                ))}
              </ul>
            </div>

            <a class="bro-cta" href={link(g.cta.slug)}>
              <span>{g.cta.tekst}</span>
              <Ikon navn="pil" />
            </a>
          </article>
        </li>
      ))}
    </ul>
    <p class="bro-note">Fotos og overflader er eksempler, og farverne er visualiseringer. Ved den gratis besigtigelse viser vi rigtige prøver, så du kan se farven i dit eget lys.</p>
  </div>

  <section class="bro-slut" aria-labelledby="bro-slut-titel">
    <div class="bro-kolonne bro-slut-indre">
      <div>
        <h2 id="bro-slut-titel">I tvivl om, hvilket gulv der passer?</h2>
        <p>Svar på seks korte spørgsmål, så ser du prisen på dit gulv. Eller ring, så hjælper vi dig med at vælge.</p>
      </div>
      <div class="bro-slut-knapper">
        <a class="knap knap-accent knap-stor" href={link('pris')}>Beregn pris på dit gulv <span aria-hidden="true">→</span></a>
        <a class="knap knap-hvid knap-stor" href={`tel:${firma.telefonLink}`} data-telefon><Ikon navn="tlf" />Ring <span data-pladsholder>{firma.telefon}</span></a>
      </div>
    </div>
  </section>

  <section class="bro-loefter" aria-label="Det får du hos os">
    <ul class="bro-kolonne bro-loefter-liste">
      {loefter.map((l) => (
        <li>
          <Ikon navn={l.ikon} class="bro-loefte-ikon" />
          <p><b data-pladsholder={l.pladsholder ? '' : undefined}>{l.titel}</b><span>{l.tekst}</span></p>
        </li>
      ))}
    </ul>
  </section>

  <dialog class="bro-stor" id="bro-stor" aria-labelledby="bro-stor-titel">
    <div class="bro-stor-hoved">
      <div>
        <h2 id="bro-stor-titel">
          {typer.map((g) => <span data-stor-type={g.slug} hidden>{g.navn}</span>)}
        </h2>
        <p class="bro-farvenavn">
          {typer.map((g) => (
            <span data-stor-type={g.slug} hidden>Farve: <b data-navn-for={g.slug}>{g.farver[0].navn}</b><span data-kode-for={g.slug}>{farvetekst(g.farver[0])}</span></span>
          ))}
        </p>
      </div>
      <button type="button" class="bro-luk" data-luk aria-label="Luk"><span aria-hidden="true">×</span></button>
    </div>
    <div class="bro-stor-billede">
      {typer.map((g) => g.farver.map((f, fi) => (
        <Image src={f.billede} alt={`${g.navn} i ${f.navn.toLowerCase()}`} widths={[800, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 1060px" quality={80} loading="lazy" decoding="async"
          data-type={g.slug} data-farve={f.slug} hidden />
      )))}
    </div>
    <div class="bro-stor-fod">
      {typer.map((g) => (
        <div class="bro-proever" role="radiogroup" aria-label={`Farver til ${g.navn}`} data-stor-type={g.slug} hidden>
          {g.farver.map((f, fi) => (
            <button type="button" role="radio" class="bro-proeve" aria-checked={fi === 0 ? 'true' : 'false'} tabindex={fi === 0 ? 0 : -1}
              data-type={g.slug} data-farve={f.slug} data-navn={f.navn} data-kode={f.kode ?? ''} aria-label={f.kode ? `${f.navn}, ${f.kode}` : f.navn}>
              <Image src={f.proeve} alt="" width={72} height={72} quality={80} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      ))}
      <a class="knap knap-accent" href={link('pris')}>Beregn pris <span aria-hidden="true">→</span></a>
    </div>
  </dialog>

  <footer slot="fod" class="bro-fod">
    <div class="bro-kolonne bro-fod-indre">
      <p>© {new Date().getFullYear()} {firma.juridiskNavn} · CVR {firma.cvr}</p>
      <p><a href={link()}>Til forsiden</a> · <a href={link('kontakt')}>Kontakt</a> · <a href={link('privatliv')}>Privatliv</a></p>
    </div>
  </footer>

  <script>
    // Farverne: et tryk (eller piletasterne) skifter overfladen på kortet og i den store visning
    const stor = document.getElementById('bro-stor') as HTMLDialogElement;
    const valgt: Record<string, string> = {};

    const visStor = (type: string) => {
      for (const el of stor.querySelectorAll<HTMLElement>('[data-stor-type]')) el.hidden = el.dataset.storType !== type;
      for (const b of stor.querySelectorAll<HTMLImageElement>('.bro-stor-billede img')) {
        b.hidden = !(b.dataset.type === type && b.dataset.farve === valgt[type]);
      }
    };

    const vaelg = (knap: HTMLElement, fokus = false) => {
      const { type, farve, navn, kode } = knap.dataset;
      valgt[type] = farve;
      for (const p of document.querySelectorAll<HTMLElement>(`.bro-proeve[data-type="${type}"]`)) {
        const er = p.dataset.farve === farve;
        p.setAttribute('aria-checked', String(er));
        p.tabIndex = er ? 0 : -1;
      }
      for (const b of document.querySelectorAll<HTMLImageElement>(`#${type} .bro-flade img`)) {
        b.hidden = b.dataset.farve !== farve;
        if (!b.hidden) { b.classList.remove('er-ny'); void b.offsetWidth; b.classList.add('er-ny'); }
      }
      for (const el of document.querySelectorAll(`[data-navn-for="${type}"]`)) el.textContent = navn;
      for (const el of document.querySelectorAll(`[data-kode-for="${type}"]`)) el.textContent = kode ? ` · ${kode}` : '';
      if (stor.open) visStor(type);
      if (fokus) knap.focus();
    };

    for (const gruppe of document.querySelectorAll<HTMLElement>('.bro-proever')) {
      const knapper = Array.from(gruppe.querySelectorAll<HTMLElement>('.bro-proeve'));
      knapper.forEach((p, i) => {
        if (p.getAttribute('aria-checked') === 'true') valgt[p.dataset.type] = p.dataset.farve;
        p.addEventListener('click', () => vaelg(p));
        p.addEventListener('keydown', (e) => {
          const ret = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
          if (!ret) return;
          e.preventDefault();
          vaelg(knapper[(i + ret + knapper.length) % knapper.length], true);
        });
      });
    }

    // Den store visning
    for (const knap of document.querySelectorAll<HTMLElement>('[data-forstoer]')) {
      knap.addEventListener('click', () => { visStor(knap.dataset.forstoer); stor.showModal(); });
      // Hent det store billede, så snart man peger på overfladen
      knap.addEventListener('pointerenter', () => {
        const t = knap.dataset.forstoer;
        const b = stor.querySelector<HTMLImageElement>(`img[data-type="${t}"][data-farve="${valgt[t]}"]`);
        if (b) b.loading = 'eager';
      });
    }
    stor.querySelector('[data-luk]').addEventListener('click', () => stor.close());
    // Et tryk på mørket uden om lukker
    stor.addEventListener('click', (e) => { if (e.target === stor) stor.close(); });
  </script>
</Side>
