---
/** Oversigt over guiderne i src/data/viden.js */
import SideBand from '../components/SideBand.astro';
import Slut from '../components/Slut.astro';
import { guides, laesetid } from '../data/viden.js';
import Side from '../layouts/Side.astro';
import { link } from '../lib/link.js';
---
<Side
  titel="Viden om epoxygulve · Guides · Silkeborg Epoxy"
  beskrivelse="Korte guides om epoxygulve: epoxy eller maling, levetid, gulvvarme, rengøring og epoxy på fliser. Skrevet af dem, der lægger gulvene."
  slug="viden"
>
  <SideBand over="Viden" titel="Viden om [epoxygulve]" tekst="Korte svar på det, folk oftest spørger om, før de får lagt et epoxygulv." sti={[{ navn: 'Viden', slug: 'viden' }]} />

  <section class="sektion" aria-label="Guides">
    <div class="kolonne">
    <ul class="guide-liste">
      {guides.map((g) => (
        <li>
          <a class="guide-kort" href={link(g.slug)}>
            <span class="guide-kort-titel">{g.h1}</span>
            <span class="guide-kort-desk">{g.kort}</span>
            <span class="guide-kort-meta">{laesetid(g)} min. at læse</span>
            <span class="yl-pil" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    </div>
  </section>

  <Slut />
</Side>
