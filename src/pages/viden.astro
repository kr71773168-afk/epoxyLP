---
/** Oversigt over guiderne i src/data/viden.js */
import Brodkrummer from '../components/Brodkrummer.astro';
import Foto from '../components/Foto.astro';
import Slut from '../components/Slut.astro';
import { guides, laesetid } from '../data/viden.js';
import Side from '../layouts/Side.astro';
import { link } from '../lib/link.js';
---
<Side
  titel="Viden om epoxygulve · Guides · Silkeborg Epoxy"
  beskrivelse="Korte guides om epoxygulve: epoxy eller maling, levetid, gulvvarme, rengøring og epoxy på fliser. Skrevet af dem, der lægger gulvene."
  slug="viden"
>
  <Brodkrummer sti={[{ navn: 'Viden', slug: 'viden' }]} />

  <section class="kolonne side-top" aria-labelledby="side-titel">
    <p class="hero-over">Viden</p>
    <h1 id="side-titel">Viden om epoxygulve</h1>
    <p class="hero-sub">Korte svar på det, folk oftest spørger om, før de får lagt et epoxygulv.</p>
  </section>

  <section class="kolonne guide-oversigt" aria-label="Guides">
    <ul class="guide-liste">
      {guides.map((g, i) => (
        <li>
          <a class="guide-kort" href={link(g.slug)}>
            <Foto navn={g.billede} alt="" class="guide-kort-billede" sizes="(max-width: 700px) 100vw, 22rem" eager={i < 2} />
            <span class="guide-kort-tekst">
              <span class="guide-kort-meta">{laesetid(g)} min. at læse</span>
              <span class="guide-kort-titel">{g.h1}</span>
              <span class="guide-kort-desk">{g.kort}</span>
              <span class="guide-kort-link">Læs guiden <span aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Slut />
</Side>
