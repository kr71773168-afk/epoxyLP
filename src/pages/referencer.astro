---
import Foto from '../components/Foto.astro';
import SideBand from '../components/SideBand.astro';
import Slut from '../components/Slut.astro';
import { referencer } from '../data/referencer.js';
import Side from '../layouts/Side.astro';
---
<Side
  titel="Referencer · Epoxygulve, vi har lavet · Silkeborg Epoxy"
  beskrivelse="Se epoxygulve, vi har lavet i garager, kældre, boliger og erhverv i Midtjylland. Med størrelse, overflade og sted."
  slug="referencer"
>
  <SideBand over="Referencer" titel="Gulve, vi har [lavet]" tekst="Et udvalg af vores jobs med størrelse, overflade og sted." sti={[{ navn: 'Referencer', slug: 'referencer' }]} foto="hal">
    <p class="kladde-note">Billederne er fra kundens egen video. Teksterne er eksempler og skal skiftes til rigtige jobs før launch.</p>
  </SideBand>

  <section class="sektion" aria-label="Referencer">
    <div class="kolonne">
    <ul class="ref-grid">
      {referencer.map((r, i) => (
        <li class="ref">
          <Foto navn={r.billede} alt={r.titel} class="ref-billede" sizes="(max-width: 760px) 100vw, 33vw" eager={i < 3} />
          <p class="ref-titel"><span data-pladsholder>{r.titel}</span></p>
          <p class="ref-meta"><span data-pladsholder>{r.sted} · {r.m2} m² · {r.overflade}</span></p>
        </li>
      ))}
    </ul>
    </div>
  </section>

  <section class="sektion sektion-alt" aria-labelledby="anm-titel">
    <div class="kolonne anmeldelser">
      <h2 class="sektion-titel" id="anm-titel">Det siger kunderne</h2>
      <p><span data-pladsholder>Her kommer anmeldelser fra Trustpilot eller Google, når de første er på plads.</span></p>
    </div>
  </section>

  <Slut foto="arbejde-taet" />
</Side>
