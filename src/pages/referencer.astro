---
import Foto from '../components/Foto.astro';
import SideBand from '../components/SideBand.astro';
import Slut from '../components/Slut.astro';
import { referencer } from '../data/referencer.js';
import Side from '../layouts/Side.astro';
---
<Side
  titel="Referencer · Fra vores arbejde med epoxygulve · Silkeborg Epoxy"
  beskrivelse="Billeder fra et af vores jobs: sådan lægger vi et epoxygulv, fra slibning og primer til epoxy og kvartssand."
  slug="referencer"
>
  <SideBand over="Referencer" titel="Fra et af vores [jobs]" tekst="Sådan ser det ud, når vi lægger et gulv. Billederne er fra et gulv i en erhvervshal." sti={[{ navn: 'Referencer', slug: 'referencer' }]} foto="hal">
    <p class="kladde-note">Kladde: flere referencer med foto af det færdige gulv, sted og m² kommer, når kunden har sendt dem.</p>
  </SideBand>

  <section class="sektion" aria-label="Referencer">
    <div class="kolonne">
    <ul class="ref-grid">
      {referencer.map((r, i) => (
        <li class="ref">
          <Foto navn={r.billede} alt={r.titel} class="ref-billede" sizes="(max-width: 760px) 100vw, 33vw" eager={i < 3} />
          <p class="ref-titel"><span class="ref-nr">{i + 1}</span>{r.titel}</p>
          <p class="ref-meta">{r.tekst}</p>
        </li>
      ))}
    </ul>
    </div>
  </section>

  <section class="sektion sektion-alt kun-pladsholder" aria-labelledby="anm-titel">
    <div class="kolonne anmeldelser">
      <h2 class="sektion-titel" id="anm-titel">Det siger kunderne</h2>
      <p><span data-pladsholder>Her kommer anmeldelser fra Trustpilot eller Google, når de første er på plads.</span></p>
    </div>
  </section>

  <Slut foto="arbejde-taet" />
</Side>
