---
import Brodkrummer from '../components/Brodkrummer.astro';
import Foto from '../components/Foto.astro';
import Slut from '../components/Slut.astro';
import Video from '../components/Video.astro';
import { firma } from '../data/firma.js';
import Side from '../layouts/Side.astro';

const vaerdier = [
  { titel: 'Du har ejerens nummer', tekst: 'Det er ejeren, der kommer ud og måler op, og som er der, når gulvet bliver lagt. Du skal ikke ringe ind til et callcenter.' },
  { titel: 'Fast pris på skrift', tekst: 'Efter besigtigelsen får du en fast pris. Den ændrer sig ikke undervejs, heller ikke hvis arbejdet tager længere tid.' },
  { titel: 'Vi dækker af og rydder op', tekst: 'Vi afdækker vægge og døre, støvsuger efter slibningen og tager affaldet med, når vi går.' },
  { titel: firma.garanti, tekst: 'Vi står inde for gulvet. Sker der noget, der skyldes vores arbejde, kommer vi og udbedrer det.' },
];
---
<Side
  titel="Om Silkeborg Epoxy · Lokalt gulvfirma i Silkeborg"
  beskrivelse="Silkeborg Epoxy er et lokalt firma, der lægger epoxygulve i garager, kældre, boliger og erhverv i Silkeborg og 60 km omkring."
  slug="om-os"
>
  <Brodkrummer sti={[{ navn: 'Om os', slug: 'om-os' }]} />

  <section class="kolonne side-hero" aria-labelledby="side-titel">
    <div class="side-hero-tekst">
      <p class="hero-over">Om os</p>
      <h1 id="side-titel">Et lokalt firma, der står inde for sine gulve</h1>
      <p class="hero-sub"><span data-pladsholder>Silkeborg Epoxy er startet af {firma.ejer}, der har lagt gulve i [X] år.</span> Vi er et lille firma, og det er ejeren selv, der kommer ud til dig.</p>
    </div>
    <Foto navn="arbejde-taet" alt="Vi trækker epoxy ud over et gulv" class="side-hero-billede" eager />
  </section>

  <section class="sektion" aria-labelledby="vaerdi-titel">
    <div class="kolonne">
      <h2 class="sektion-titel" id="vaerdi-titel">Det kan du regne med</h2>
      <ul class="fordele">
        {vaerdier.map((v) => (
          <li>
            <h3 data-pladsholder={v.titel === firma.garanti ? '' : undefined}>{v.titel}</h3>
            <p>{v.tekst}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sektion" aria-labelledby="historie-titel">
    <div class="kolonne om-grid">
      <div class="afsnit">
        <h2 id="historie-titel">Historien</h2>
        <p data-pladsholder>Her skal ejerens egen historie stå: hvorfor han startede, hvad han har lavet før, og hvad han går op i. Kort og i hans egne ord.</p>
        <h2>Firmaoplysninger</h2>
        <p>{firma.juridiskNavn}<br>CVR {firma.cvr}<br><span data-pladsholder>{firma.adresse.vej}, {firma.adresse.postnr} {firma.adresse.by}</span></p>
      </div>
      <Video />
    </div>
  </section>

  <Slut />
</Side>
