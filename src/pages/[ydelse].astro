---
/**
 * Én side pr. ydelse fra src/data/ydelser.js: garagegulv, kældergulv, erhverv, flakes osv.
 * Beregneren står øverst med rummet eller overfladen valgt på forhånd, ligesom på forsiden.
 */
import cfg from '../calculator/pricing.config.js';
import Brodkrummer from '../components/Brodkrummer.astro';
import FAQ from '../components/FAQ.astro';
import Forloeb from '../components/Forloeb.astro';
import Hero from '../components/Hero.astro';
import Ikon from '../components/Ikon.astro';
import Slut from '../components/Slut.astro';
import YdelsesListe from '../components/YdelsesListe.astro';
import { firma } from '../data/firma.js';
import { guide } from '../data/viden.js';
import { ydelse, ydelser } from '../data/ydelser.js';
import Side from '../layouts/Side.astro';
import { link } from '../lib/link.js';

export function getStaticPaths() {
  return ydelser.map((y) => ({ params: { ydelse: y.slug }, props: { y } }));
}

const { y } = Astro.props;
const gruppe = { privat: 'Privat', erhverv: 'Erhverv', gulvtype: 'Gulvtyper' }[y.gruppe];
const relaterede = y.relaterede.map(ydelse).filter(Boolean);
const laesOgsaa = (y.guides ?? []).map(guide).filter(Boolean);
const fmt = (n) => Math.round(n).toLocaleString('da-DK');
const erhverv = Boolean(cfg.rum[y.rum]?.erhverv);
const moms = erhverv ? 1 : 1 + cfg.moms;
const prisPrM2 = y.overflade
  ? cfg.overflader[y.overflade].prisPrM2
  : Math.min(...Object.values(cfg.overflader).map((o) => o.prisPrM2));
const fraPris = `fra ${fmt(prisPrM2 * moms)} kr/m²`;
// Foto i toppen: gulvtypen selv, eller et foto, der passer til rummet
const foto = y.overflade ? `gulv-${y.overflade}` : { garage: 'gulv-flakes', kaelder: 'gulv-ensfarvet', bolig: 'gulv-bolig', erhverv: 'hal' }[y.rum] ?? 'hal';

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: y.h1,
  description: y.beskrivelse,
  provider: { '@type': 'HomeAndConstructionBusiness', name: firma.navn },
  areaServed: { '@type': 'AdministrativeArea', name: 'Midtjylland' },
};
---
<Side titel={y.titel} beskrivelse={y.beskrivelse} slug={y.slug} schema={[service]}>
  <Hero
    over={gruppe}
    titel={y.h1}
    tekst={y.intro}
    medie={foto}
    rum={y.rum}
    overflade={y.overflade}
    punkter={['Fast pris på skrift efter gratis besigtigelse', `<span data-pladsholder>${firma.garanti}</span>, og ejeren kommer selv`]}
  >
    <Brodkrummer slot="top" sti={[{ navn: y.navn, slug: y.slug }]} class="" />
    <p class="fra-pris"><strong data-pladsholder>{fraPris}</strong> {erhverv ? 'ekskl. moms' : 'inkl. moms'}, vejledende</p>
  </Hero>

  <section class="sektion" aria-labelledby="fordele-titel">
    <div class="kolonne">
      <h2 class="sektion-titel" id="fordele-titel">{y.fordeleTitel}</h2>
      <ul class="fordele">
        {y.fordele.map((f) => (
          <li>
            <Ikon navn="tjek" />
            <h3>{f.titel}</h3>
            <p>{f.tekst}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Forloeb alt />

  <section class="sektion" aria-label={`Mere om ${y.navn.toLowerCase()}`}>
    <div class="kolonne afsnit-grid">
      {y.afsnit.map((a) => (
        <div class="afsnit">
          <h2>{a.titel}</h2>
          <p>{a.tekst}</p>
        </div>
      ))}
    </div>
  </section>

  <FAQ items={y.faq} titel={`Spørgsmål om ${y.navn.toLowerCase()}`} alt />

  <section class="sektion" aria-labelledby="se-ogsaa">
    <div class="kolonne">
      <h2 class="sektion-titel" id="se-ogsaa">Se også</h2>
      <YdelsesListe ydelser={relaterede} />
      {laesOgsaa.length > 0 && (
        <div class="laes-ogsaa">
          <p class="laes-ogsaa-titel">Guides</p>
          <ul>{laesOgsaa.map((g) => <li><a class="pil-link" href={link(g.slug)}>{g.h1} <span aria-hidden="true">→</span></a></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <Slut harBeregner />
</Side>
